        <mxCell id="--buOZfVmqUr9cxPIW7L-27" value="$$\begin{aligned} x &amp;amp; = X^d \\ y &amp;amp; = Y^d&amp;nbsp;\\ c_0 &amp;amp;= m_0\oplus \textsf{lsb}(x) \\ c_1 &amp;amp;= m_1\oplus \textsf{lsb}(y)\end{aligned}$$" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;spacingTop=-15;" parent="--buOZfVmqUr9cxPIW7L-38" vertex="1">
