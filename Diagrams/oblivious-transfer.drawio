        <mxCell id="--buOZfVmqUr9cxPIW7L-26" value="$$(X,Y) := \begin{cases} (S, T) &amp;amp; \text{if } b = 0 \\ (T, S) &amp;amp;\text{if } b = 1&amp;nbsp;\end{cases}$$" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;spacingTop=-10;align=left;" parent="--buOZfVmqUr9cxPIW7L-38" vertex="1">
