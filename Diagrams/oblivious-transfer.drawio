        <mxCell id="etyT-UjanfQ1QplT1CXO-10" value="\begin{aligned} u_0 \xleftarrow{\$}&amp;nbsp; \mathbb{Z}/\ell\mathbb{Z} &amp;amp; \quad v_0&amp;nbsp; \xleftarrow{\$}&amp;nbsp; \mathbb{Z}/\ell\mathbb{Z} \\ u_1 \xleftarrow{\$}&amp;nbsp; \mathbb{Z}/\ell\mathbb{Z} &amp;amp; \quad v_1&amp;nbsp; \xleftarrow{\$}&amp;nbsp; \mathbb{Z}/\ell\mathbb{Z} \\W_0 = Q^{u_0}g^{v_0} &amp;amp; \quad C_0&amp;nbsp; = m_0X^{u_0}R^{v_0} \\ W_1 = Q^{u_1}g^{v_1} &amp;amp; \quad C_1&amp;nbsp; = m_1X^{u_1}R^{v_1}&amp;nbsp;&amp;nbsp;\end{aligned}" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;spacingTop=-15;align=right;" vertex="1" parent="etyT-UjanfQ1QplT1CXO-18">
