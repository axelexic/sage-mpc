        <mxCell id="VIY9WyFwEbRAb00au7sx-17" value="\begin{aligned} q &amp;amp;\xleftarrow{\$} \mathbb{Z}/\ell\mathbb{Z} &amp;amp; &amp;amp; Q = g^q \\ r &amp;amp;\xleftarrow{\$} \mathbb{Z}/\ell\mathbb{Z} &amp;amp; &amp;amp; R = g^r&amp;nbsp; \\ s &amp;amp;= q\cdot r &amp;amp;&amp;nbsp; &amp;amp; S = g^s&amp;nbsp;&amp;nbsp;\\ t &amp;amp;\xleftarrow{\$} \mathbb{Z}/\ell\mathbb{Z} &amp;amp;&amp;nbsp; &amp;amp; T = g^t&amp;nbsp;\end{aligned}" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;spacingTop=-15;" vertex="1" parent="etyT-UjanfQ1QplT1CXO-18">
