        <mxCell id="--buOZfVmqUr9cxPIW7L-24" value="$$\begin{aligned} T &amp;amp; \xleftarrow{\$} (\mathbb{Z}/n\mathbb{Z})^\times \\ s &amp;amp; \xleftarrow{\$} (\mathbb{Z}/n\mathbb{Z})^\times \\&amp;nbsp;S &amp;amp;= s^e \end{aligned}$$" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;spacingTop=-15;" parent="--buOZfVmqUr9cxPIW7L-38" vertex="1">
